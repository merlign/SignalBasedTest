# ============================================================
# Vacancy Monitoring System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── App ───────────────────────────────────────────────────────────────────
# Public base URL of your Vercel deployment (no trailing slash)
APP_BASE_URL=https://your-project.vercel.app

# Secret used to authenticate Vercel's cron job calls
CRON_SECRET=replace_with_random_secret

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Use the service role key (not the anon key) — keep this secret!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Clay ──────────────────────────────────────────────────────────────────
# The incoming webhook URL Clay provides for your table
CLAY_WEBHOOK_URL=https://clay.com/webhooks/...
# Optional API key if Clay requires authentication
CLAY_API_KEY=

# Shared secret Clay sends in the X-Clay-Secret header on callbacks
CLAY_CALLBACK_SECRET=replace_with_random_secret

# ── Simplicate ────────────────────────────────────────────────────────────
SIMPLICATE_BASE_URL=https://api.simplicate.nl/v2
SIMPLICATE_API_KEY=your_simplicate_api_key
SIMPLICATE_API_SECRET=your_simplicate_api_secret

# ID of the lead source to use (find via GET /v2/sales/source)
SIMPLICATE_LEAD_SOURCE_ID=

# Optional: custom field IDs for vacancy URL and sector
# Find these via GET /v2/customfields/customfield
SIMPLICATE_CF_VACANCY_URL=
SIMPLICATE_CF_SECTOR=

# Status ID to set on a Simplicate lead after outreach is sent
SIMPLICATE_CONTACTED_STATUS_ID=

# Medewerker ID die de taak krijgt bij een ultieme lead
# Vind dit via GET /v2/hrm/employee
SIMPLICATE_ASSIGNEE_ID=

# ── Ultieme lead criteria ─────────────────────────────────────────────────
LEAD_MIN_EMPLOYEES=25
LEAD_MIN_VACANCIES=3
# Komma-gescheiden lijst van landen (lowercase)
LEAD_COUNTRIES=nederland,belgie,belgium,belgië

# ── Outreach ──────────────────────────────────────────────────────────────
# Choose your provider: instantly | lemlist
OUTREACH_PROVIDER=instantly

# Instantly
INSTANTLY_WEBHOOK_URL=https://api.instantly.ai/api/v1/lead/add
INSTANTLY_API_KEY=your_instantly_api_key
INSTANTLY_CAMPAIGN_ID=your_campaign_id

# Lemlist (only needed when OUTREACH_PROVIDER=lemlist)
LEMLIST_WEBHOOK_URL=https://api.lemlist.com/api/campaigns/YOUR_CAMPAIGN_ID/leads
LEMLIST_API_KEY=your_lemlist_api_key
