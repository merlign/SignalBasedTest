{
  "name": "vacancy-monitoring-system",
  "version": "1.0.0",
  "description": "Automated vacancy monitoring system that scrapes Indeed.nl and creates leads in Simplicate",
  "main": "api/cron.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node api/cron.js",
    "bouw":        "node scripts/scrape-sector.js bouw",
    "techniek":    "node scripts/scrape-sector.js techniek",
    "it":          "node scripts/scrape-sector.js it",
    "backoffice":  "node scripts/scrape-sector.js backoffice",
    "productie":   "node scripts/scrape-sector.js productie",
    "supplychain": "node scripts/scrape-sector.js supplychain",
    "logistiek":   "node scripts/scrape-sector.js logistiek",
    "transport":   "node scripts/scrape-sector.js transport",
    "test:filter": "node -e \"const {filterVacancies}=require('./src/filter');const v=[{id:'1',title:'Uitvoerder Bouw',company:'Randstad Uitzendbureau',snippet:'',sector:'bouw'},{id:'2',title:'Uitvoerder Bouw',company:'Van Baaren Aannemers',snippet:'',sector:'bouw'}];console.log(JSON.stringify(filterVacancies(v),null,2))\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.5",
    "axios-retry": "^4.0.0",
    "cheerio": "^1.0.0-rc.12",
    "node-cron": "^3.0.3",
    "p-limit": "^5.0.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "dotenv": "^16.3.1"
  }
}
